{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Goliath-Research/GoliathAlign/blob/main/.goliath/product.schema.json",
  "title": "Goliath product summary",
  "description": "Machine-readable product summary. dependsOn lists upstream product ids and is optional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "tagline",
    "description",
    "category",
    "features",
    "links",
    "related",
    "license",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "description": "Stable product id, lowercase."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Two to four sentences of Markdown."
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "docs", "website"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "docs": {
          "type": ["string", "null"]
        },
        "website": {
          "type": ["string", "null"]
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*$"
      },
      "description": "Other product ids to show beside this one. Empty when none apply."
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*$"
      },
      "description": "Optional. Upstream product ids this product requires. Empty for a standalone tool."
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  }
}
